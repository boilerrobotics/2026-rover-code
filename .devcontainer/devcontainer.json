
{
    "name": "brc-ros2-humble",

    "build": {
        "dockerfile": "Dockerfile",
        "context": "."
    },

    "remoteUser": "devuser",

    "containerEnv": {
        "ROS_DOMAIN_ID": "0",
        "DISPLAY": ":1",
        "QT_X11_NO_MITSHM": "1"
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "Ranch-Hand-Robotics.rde-ros-2",
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-vscode.cpptools",
                "redhat.vscode-yaml"
            ],

            "settings": {
                "python.defaultInterpreterPath": "/usr/bin/python3",
                "terminal.integrated.defaultProfile.linux": "bash"
            }
        }
    },

    "features": {
        "ghcr.io/devcontainers/features/desktop-lite:1": {}
    },

    "forwardPorts": [
        6080
    ],

    "portsAttributes": {
        "6080": {
            "label": "Desktop (noVNC)",
            "onAutoForward": "openBrowser"
        }
    },

    "postCreateCommand": "bash /workspaces/2026-rover-code/post_create.sh",

    "postStartCommand": "bash /workspaces/2026-rover-code/fetch_bags.sh"
}
